# Copy to .env on the VPS and fill in. Never commit .env.

# Where the board is served (DNS A record must point at the VPS before first start, Caddy fetches the certificate)
DOMAIN=incentive.meubelgrande.com
ACME_EMAIL=tech@bpropms.com

# Database password for the Postgres container
DB_PASSWORD=change-me-long-random

# Session signing secret: openssl rand -hex 32
SESSION_SECRET=change-me-64-hex

# Sign-in providers (configure one or both). Redirect URI to register: https://DOMAIN/api/auth/callback/google  or  .../callback/microsoft
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
OIDC_MICROSOFT_TENANT=common

# WhatsApp Business API (Meta Cloud API). Template `incentive_update` with one body parameter must be approved.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=incentive_update
WHATSAPP_TEMPLATE_LANG=en

# Email (SMTP URL and sender). Example: smtps://apikey:SG.xxx@smtp.sendgrid.net:465
SMTP_URL=
MAIL_FROM="Incentive board <incentive@meubelgrande.com>"

# Feeds for the http-json adapter (optional; see backend/jobs/adapters)
FEED_API_TOKEN=
ERP_ORDERS_URL=
ERP_CUSTOMERS_URL=
ERP_TARGETS_URL=
BIO_ATTENDANCE_URL=
CRM_WALKINS_URL=
CRM_FOLLOWUPS_URL=
DELIVERY_URL=

# Safety switches: DRY_RUN=1 logs sends without sending; JOBS=0 disables schedules; DEV_LOGIN=1 only on a dev machine
DRY_RUN=1
JOBS=1
DEV_LOGIN=0
